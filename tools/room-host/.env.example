# Copy to .env and fill in. .env is gitignored and never leaves this machine -
# none of it is set on Vercel, and none of it reaches the browser.

# --- Wyze -------------------------------------------------------------------
# The account the camera is on, plus an API key from
# https://developer-api-console.wyze.com/#/apikey/view
WYZE_EMAIL=
WYZE_PASSWORD=
WYZE_API_ID=
WYZE_API_KEY=
# The camera's name in the Wyze app, lowercased with dashes for spaces. The
# bridge derives its stream path from this, so "Front Room" is front-room and
# the streams are rtsp://127.0.0.1:8554/front-room and /front-room/index.m3u8
CAM_NAME=front-room

# --- The site ---------------------------------------------------------------
# The Vercel copy. instellar.net is GitHub Pages and has no /api/*.
ROOM_API=https://go.instellar.net/api/room
# The view key goes in the watch link and reaches everyone invited to watch.
# The publish key stays here and never leaves this machine. They must not be the
# same string: the split is what stops a viewer repointing the camera.
ROOM_VIEW=
ROOM_PUBLISH=
# Only if ROOM_TOKEN (or CAST_TOKEN) is set on Vercel.
ROOM_ADMIN_TOKEN=

# --- Speech to text ---------------------------------------------------------
# From https://console.deepgram.com/ . The room's audio is streamed to Deepgram,
# so leaving this blank is the switch that keeps the room's audio in the house -
# the video and the talking still work, there is simply no transcript.
DEEPGRAM_KEY=
